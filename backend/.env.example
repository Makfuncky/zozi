APP_ENV=development
SECRET_KEY=<GENERATE: python -c "import secrets; print(secrets.token_hex(32))">
FIELD_ENCRYPTION_KEY=<GENERATE: python -c "import secrets; print(secrets.token_hex(32))">
POSTGRES_PASSWORD=<SET_IN_COOLIFY>
DATABASE_URL=sqlite:///./zozi.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Seed passwords (required when SEED_DATA_ON_STARTUP=true)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ------------------------------------------------------------------
# Test-suite requirements (pytest sets these automatically in conftest.py)
# ------------------------------------------------------------------
# DATABASE_URL_DIRECT must be >= 10 chars; any valid DB URL works in tests.
# DATABASE_URL is overridden by conftest to sqlite for test isolation.
# FIELD_ENCRYPTION_SALT must be >= 32 hex chars; conftest sets a dummy.
# All payment / provider / comms secrets below are set to deterministic
# test-only dummies by conftest.py.  They exist solely so that
# Settings(app_env="development") and module-level imports succeed during
# collection.  Override in CI if needed.
# ------------------------------------------------------------------
# Database
POSTGRES_DB=test_db
POSTGRES_USER=test
POSTGRES_PASSWORD=test
DATABASE_URL_DIRECT=postgresql://test:test@localhost/test_db

# Encryption
FIELD_ENCRYPTION_SALT=<GENERATE: python -c "import secrets; print(secrets.token_hex(32))">

# Payment providers
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_test_dummy
TAP_SECRET_KEY=tap_test_dummy
TAP_WEBHOOK_SECRET=tap_whsec_test_dummy
TAP_API_BASE_URL=https://api.tap_dummy.test
PAYTABS_SERVER_KEY=paytabs_test_dummy
PAYTABS_WEBHOOK_SECRET=paytabs_whsec_test_dummy
PAYTABS_PROFILE_ID=paytabs_profile_test_dummy
PAYTABS_API_BASE_URL=https://api.paytabs_dummy.test
PAYTABS_CALLBACK_URL=https://callback.paytabs_dummy.test
THAWANI_SECRET_KEY=thawani_test_dummy
THAWANI_PUBLISHABLE_KEY=thawani_pub_test_dummy
THAWANI_API_BASE_URL=https://api.thawani_dummy.test
THAWANI_WEBHOOK_SECRET=thawani_whsec_test_dummy
PAYPAL_SECRET=dummy_paypal_secret
PAYPAL_CLIENT_ID=dummy_paypal_client_id
PAYPAL_WEBHOOK_SECRET=dummy_paypal_webhook_secret

# AI / external
OPENAI_API_KEY=sk-test-dummy-openai
SENTRY_DSN=https://dummy@sentry.example.invalid/1
HF_API_TOKEN=hf_dummy_token

# Comms
TWILIO_ACCOUNT_SID=AC_dummy_twilio_sid
TWILIO_AUTH_TOKEN=dummy_twilio_token
WHATSAPP_ACCOUNT_SID=AC_dummy_whatsapp_sid
WHATSAPP_AUTH_TOKEN=dummy_whatsapp_token
WHATSAPP_FROM_NUMBER=+10000000000
RESEND_API_KEY=re_dummy_resend_key
RESEND_WEBHOOK_SECRET=whsec_dummy_resend
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test
SMTP_PASSWORD=test

# Social / SSO
GOOGLE_CLIENT_ID=dummy_google_client_id
GOOGLE_CLIENT_SECRET=dummy_google_client_secret
FACEBOOK_CLIENT_ID=dummy_facebook_client_id
FACEBOOK_CLIENT_SECRET=dummy_facebook_client_secret
SSO_CLIENT_ID=dummy_sso_client_id

# Storage / infra
VALKEY_URL=valkey://localhost:6379/0
CELERY_BROKER_URL=valkey://localhost:6379/1
CELERY_RESULT_BACKEND=valkey://localhost:6379/2
R2_BUCKET=dummy-r2-bucket
R2_ENDPOINT_URL=https://s3.dummy-r2.example.invalid
R2_ACCESS_KEY_ID=dummy_r2_access_key
R2_SECRET_ACCESS_KEY=dummy_r2_secret_key
MEDIA_STORAGE_BASE=./uploads

# Security / misc
ENCRYPTION_KEY=test-encryption-key-dummy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KMS_ENCRYPTION_KEY=test-kms-key-dummy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HASH_SALT=test-hash-salt-dummy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUDIT_CHAIN_KEY=test-audit-chain-key-dummy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRUSTED_PROXY_IPS=10.0.0.0/8
BANK_API_AUTH_TOKEN=dummy_bank_auth_token
BANK_API_SOURCE_ACCOUNT_ID=dummy_bank_source_account
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

