CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Seed passwords (required when SEED_DATA_ON_STARTUP=true)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

