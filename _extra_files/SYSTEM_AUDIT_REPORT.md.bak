        FE["Next.js 15 (ISR/edge)"]; BE["FastAPI pods (AsyncPG Phase B target)"]; WR["Async workers (Kafka consumers — Phase C)"]
    end
    subgraph MESH["EVENT & DATA MESH (Phase C target)"]
        KAFKA["Kafka (event bus)"]; CDC["Debezium (WAL CDC)"]; REDIS["Redis Cluster (sessions, cart, cache, pub/sub)"]; ES["OpenSearch/ES (catalog facets)"]
    end
