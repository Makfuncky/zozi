#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────
# ZOZI Architecture Gate — Pre-commit Hook
#
# Runs pytest gate tests on staged .py files only.  If any test FAILS
# (not skips), the commit is blocked.
#
# Install: git config core.hooksPath .githooks
# ──────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
BACKEND_DIR="$REPO_ROOT/backend"
GATE_TEST="$REPO_ROOT/tests/test_architecture_gates.py"

# ── Colours ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Colour

# ── Quick exit: nothing staged ────────────────────────────────────────
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' | head -1)
if [ -z "$STAGED_PY" ]; then
    echo -e "${GREEN}✅ No staged .py files — skipping architecture gate.${NC}"
    exit 0
fi

# ── Check if the gate test file exists ────────────────────────────────
if [ ! -f "$GATE_TEST" ]; then
    echo -e "${YELLOW}⚠️  tests/test_architecture_gates.py not found — skipping.${NC}"
    exit 0
fi

echo -e "${YELLOW}🔍 Running architecture gate tests …${NC}"
echo "   Staged .py files: $(git diff --cached --name-only --diff-filter=ACM -- '*.py' | wc -l)"

# ── Run gate tests ───────────────────────────────────────────────────
# Use subprocess-isolated boot test, skip slow full-repo scans on commit
cd "$BACKEND_DIR"
SECRET_KEY=test-secret-key-for-dev-only python -m pytest \
    "$GATE_TEST" \
    -v \
    --tb=short \
    --timeout=120 \
    -x \
    2>&1 | tail -40

EXIT_CODE=${PIPESTATUS[0]}

# ── Router generation drift gate (Design 3) ────────────────────────
# If a controller / the @route decorator / the generator changed, the committed
# routers in routers/ must be regenerated. Block the commit on drift.
ROUTER_RELEVANT=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^backend/(controllers/|routers/generated/auto_router\.py)' \
    | head -1 || true)

if [ -n "$ROUTER_RELEVANT" ]; then
    echo -e "${YELLOW}🔍 Verifying generated routers are in sync …${NC}"
    SECRET_KEY=test-secret-key-for-dev-only python routers/generated/auto_router.py --verify 2>&1 | tail -20
    REXIT=${PIPESTATUS[0]}
    if [ "$REXIT" -ne 0 ]; then
        echo ""
        echo -e "${RED}❌ Router generation drift — commit blocked.${NC}"
        echo -e "${RED}   Run: make routers  (or: cd backend && python routers/generated/auto_router.py)${NC}"
        echo ""
        echo "   To bypass (not recommended):  git commit --no-verify"
        exit 1
    fi
    echo -e "${GREEN}✅ Generated routers in sync.${NC}"
fi

if [ "$EXIT_CODE" -eq 0 ]; then
    echo ""
    echo -e "${GREEN}✅ Architecture gate passed — commit allowed.${NC}"
    exit 0
else
    echo ""
    echo -e "${RED}❌ Architecture gate FAILED (exit $EXIT_CODE) — commit blocked.${NC}"
    echo -e "${RED}   Fix the violations above, then try again.${NC}"
    echo ""
    echo "   To bypass (not recommended):  git commit --no-verify"
    exit 1
fi
