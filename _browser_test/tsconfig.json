{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "paths": {
    "@fixtures": ["tests/fixtures"],
    "@api": ["src/api"],
    "@auth": ["src/auth"],
    "@actions": ["src/actions"],
    "@workflows": ["src/workflows"],
    "@monitor": ["src/monitor"]
  }
}
