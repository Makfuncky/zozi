# WARNING: DO NOT commit real secrets. This is an example file.
# Copy this file to config/stack.env.ps1 and replace the example values
# with your local environment secrets. Ensure the real file is ignored by git.

# Application environment
$env:APP_ENV = 'development'

# Service URLs
$env:BACKEND_URL = 'http://127.0.0.1:8000'
$env:FRONTEND_URL = 'http://127.0.0.1:3100'

# Database connection (Supabase/Neon)
$env:DATABASE_URL = 'postgresql://user:pass@localhost:5432/zozi_test'

# Security
$env:SECRET_KEY = 'replace-me-with-real-secret'

# Task queue (Valkey/Redis)
$env:CELERY_BROKER_URL = 'valkey://localhost:6379/0'

# File storage
$env:STORAGE_BACKEND = 'local'
$env:S3_BUCKET = 'zozi-media'
$env:S3_ACCESS_KEY_ID = 'replace-me'
$env:S3_SECRET_ACCESS_KEY = 'replace-me'
