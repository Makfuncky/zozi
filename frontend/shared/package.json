{
    "name": "@zozi/shared",
    "version": "1.0.0",
    "private": true,
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "npx jest --passWithNoTests",
        "check:component-porting": "npm run lint --prefix ../web_app && npm run lint --prefix ../mobile_app && npm run typecheck && npm test",
        "build": "tsc --outDir dist --declaration"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-native": "^0.81.0",
        "react-native-svg": ">=15.15.3",
        "react-native-web": "^0.21.0"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "framer-motion": "^12.0.0",
        "lucide-react": "^0.563.0",
        "tailwind-merge": "^3.5.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^29.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.17",
        "@types/react-native": "~0.81.0",
        "jest": "^29.0.0",
        "jest-environment-jsdom": "^29.0.0",
        "react": "^19.2.17",
        "react-dom": "^19.2.17",
        "ts-jest": "^29.0.0",
        "typescript": "^5.9.3"
    }
}