{
  "expo": {
    "name": "ZOZI",
    "slug": "zozi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zozi.marketplace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1120"
      },
      "package": "com.zozi.marketplace"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1120"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "zozi"
  }
}
