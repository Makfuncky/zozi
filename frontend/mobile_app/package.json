{
  "name": "zozi-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --runInBand --config jest.config.js",
    "test:e2e:detox:build:android": "detox build -c android.emu.release",
    "test:e2e:detox:android": "detox test -c android.emu.release --headless",
    "test:e2e:detox:android:smoke": "detox test -c android.emu.release --headless e2e/auth-login-smoke.e2e.js e2e/customer-browse-checkout-smoke.e2e.js e2e/role-dashboard-smoke.e2e.js",
    "test:e2e:detox:android:nightly": "detox test -c android.emu.release --headless",
    "test:e2e:detox:build:android:debug": "detox build -c android.emu.debug",
    "test:e2e:detox:android:debug": "set DETOX_LAUNCH_MODE=dev-client && detox test -c android.emu.debug --headless",
    "postinstall": "node patch-logbox.js",
    "cleanup:bak": "node -e \"const fs=require('fs'); const path=require('path'); const root=process.cwd(); function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){const full=path.join(dir,entry.name); if(entry.isDirectory()){walk(full);} else if(full.endsWith('.bak')||full.endsWith('.backup')){console.log('Removing', full); fs.unlinkSync(full);} }}; walk(root); console.log('Cleanup complete');\"",
    "android:dev": "npx react-native run-android",
    "android:build": "cd android && gradlew assembleDebug",
    "prebuild": "expo prebuild --platform android",
    "prebuild:clean": "expo prebuild --clean --platform android"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.0",
    "@zozi/shared": "file:../shared/dist",
    "clsx": "^2.1.1",
    "expo": "^55.0.8",
    "expo-blur": "^55.0.10",
    "expo-camera": "~17.0.8",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.22",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.12",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^55.0.9",
    "expo-linking": "~55.0.8",
    "expo-print": "~55.0.9",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.9",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "is-arrayish": "^0.3.4",
    "pngjs": "^7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4",
    "semver": "^7.8.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "@types/react-native": "~0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "detox": "^20.27.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
