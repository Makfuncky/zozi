# Frontend Dockerfile
# Build context is the top-level frontend/ directory so the web app can resolve
# the local ../shared package dependency (file:../shared) during pnpm install
# (see documents/FILE_ORGANIZATION_RULES.md: context = frontend/).
#
# Stages: base -> deps -> builder -> runner
# Versions:
#   - Node.js 22.14.0 (Alpine)  -> satisfies pnpm@11.9.0's engines
#     (node >=22.13); the previously pinned 22.12.0 is too old for the
#     pnpm version required by package.json's packageManager field
#   - pnpm 11.9.0 via corepack, driven by package.json `packageManager`
#     (lockfile was generated by pnpm 11.9.0; pnpm 10 would reject
#     lockfileVersion 9.0)
#   - Multi-stage (builder + runner), no devDependencies in the prod image
FROM node:22.14.0-alpine AS base

# corepack provides pnpm; the exact version comes from package.json's
# "packageManager": "pnpm@11.9.0" field, so local/CI/Docker never drift.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# -----------------------------------------------------------------------------
# deps: resolve dependencies from pnpm-lock.yaml.
# Cached separately: this layer only invalidates when the manifests, the
# lockfile, or the ../shared package sources change.
# -----------------------------------------------------------------------------
FROM base AS deps

WORKDIR /app

# pnpm/peer config lives next to the workspace root (frontend/.npmrc).
COPY .npmrc ./.npmrc
COPY shared ./shared
COPY web_app/package.json web_app/pnpm-lock.yaml web_app/pnpm-workspace.yaml ./web_app/

WORKDIR /app/web_app

RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# builder: full source layered on top of the installed dependencies, then
# production build. node_modules from the deps stage is preserved because
# node_modules/.next are excluded from the build context by .dockerignore.
# -----------------------------------------------------------------------------
FROM base AS builder

WORKDIR /app

COPY --from=deps /app /app
COPY web_app ./web_app

WORKDIR /app/web_app

RUN pnpm build

# -----------------------------------------------------------------------------
# runner: minimal production image running as the unprivileged `node` user.
# next.config.ts has no `output: 'standalone'`, so the production dependency
# tree must be shipped; the app is started with `pnpm start` (`next start`).
# -----------------------------------------------------------------------------
FROM base AS runner

WORKDIR /app/web_app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=builder --chown=node:node /app/shared /app/shared
COPY --from=builder --chown=node:node /app/web_app/package.json ./package.json
COPY --from=builder --chown=node:node /app/web_app/next.config.ts ./next.config.ts
COPY --from=builder --chown=node:node /app/web_app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/web_app/.next ./.next
COPY --from=builder --chown=node:node /app/web_app/public ./public

USER node

EXPOSE 3000

CMD ["pnpm", "start"]
