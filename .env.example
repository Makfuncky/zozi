APP_ENV=development
SECRET_KEY=change-this-to-a-strong-random-key
ALGORITHM=HS256
APP_VERSION=1.0.0
RUNTIME_PROFILE=standard
DEBUG=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
# Short-lived access tokens (5-15 min) with refresh rotation
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_DATA_ON_STARTUP=true
BOOTSTRAP_SCHEMA_ON_STARTUP=false
RUN_LEGACY_MIGRATIONS_ON_STARTUP=false
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_SUPPLIER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# asyncpg does not accept libpq-style query parameters like sslmode.
# SSL is negotiated automatically by asyncpg for non-localhost connections.
# Do not add ?sslmode=require — it will break with "unexpected keyword argument".
# PostgreSQL for development (matches docker-compose)
DATABASE_URL=postgresql+asyncpg://zozimarketplace:zozimarketplace@localhost:5432/zozimarketplace
# Direct DSN for Alembic / schema operations (bypasses pooler).
DATABASE_URL_DIRECT=postgresql+asyncpg://zozimarketplace:zozimarketplace@localhost:5432/zozimarketplace
DATABASE_REPLICA_URL=
POSTGRES_DB=zozimarketplace
POSTGRES_USER=zozimarketplace
POSTGRES_PASSWORD=zozimarketplace
DB_SSL_MODE=prefer
DB_STATEMENT_TIMEOUT=60000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Valkey (canonical env var is VALKEY_URL)
VALKEY_URL=valkey://localhost:6379
READINESS_REQUIRE_VALKEY=true
READINESS_REQUIRE_EMAIL=true
READINESS_REQUIRE_PAYMENTS=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:19006,http://localhost:19000,http://127.0.0.1:19006,http://127.0.0.1:19000,http://localhost:8081,http://localhost:8090,http://127.0.0.1:8081,http://127.0.0.1:8090

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@zozi.com
EMAIL_SCHEDULER_ENABLED=false

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_CONNECT_AUTO_CREATE_ACCOUNTS=false

TAP_SECRET_KEY=
TAP_WEBHOOK_SECRET=
TAP_WEBHOOK_URL=
TAP_API_BASE_URL=

PAYTABS_SERVER_KEY=
PAYTABS_WEBHOOK_SECRET=
PAYTABS_PROFILE_ID=
PAYTABS_API_BASE_URL=
PAYTABS_CALLBACK_URL=

THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_API_BASE_URL=
THAWANI_WEBHOOK_SECRET=

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

OPENAI_API_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MAX_BACKUPS=48
BACKUP_MAX_FILES=48
BACKUP_INTERVAL_MINUTES=30
BACKUP_ENABLED=true

# Storage (Cloudflare R2; S3_* names kept as backward-compat aliases)
STORAGE_BACKEND=r2
MEDIA_STORAGE_BASE=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT_URL=
R2_CDN_BASE=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_TTL_SECONDS=900
PRESIGNED_UPLOADS_ENABLED=false
# Legacy S3_* aliases (still work; new code should use R2_*)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_CDN_BASE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Encryption and secrets
ENCRYPTION_KEY=
KMS_ENCRYPTION_KEY=
HASH_SALT=
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_FROM_ENV=
FIELD_ENCRYPTION_KEY_FILE=
FIELD_ENCRYPTION_KEY_SOURCE=auto
FIELD_ENCRYPTION_KEY_VAULT_ADDR=
FIELD_ENCRYPTION_KEY_VAULT_TOKEN=
FIELD_ENCRYPTION_KEY_VAULT_PATH=
FIELD_ENCRYPTION_KEY_VAULT_FIELD=field_encryption_key
FIELD_ENCRYPTION_KEY_AWS_SSM_PARAMETER=
FIELD_ENCRYPTION_KEY_AWS_REGION=

# Celery settings
CELERY_BROKER_URL=valkey://localhost:6379/1
CELERY_RESULT_BACKEND=valkey://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
BACKGROUND_JOB_WORKERS=2
BACKGROUND_JOB_TTL_SECONDS=3600
BACKGROUND_JOBS_ENABLED=false

# ML Workers for background processing
ML_WORKERS=2

# Monitoring and security
SENTRY_DSN=
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_IPS=
FRAUD_PROXY_SEED_IPS=
AUDIT_CHAIN_KEY=

# OAuth providers
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
SSO_CLIENT_ID=
CUSTOMER_EMAIL_VERIFICATION_MODE=auto

# Finance
VAT_RATE=0.0
OZI_COMMISSION_RATE=0.1
DEFAULT_COMMISSION_RATE_PCT=15.0
PAYOUT_HOLDING_DAYS=7
FINANCE_AUTO_RECONCILE_BATCH_LIMIT=100
FINANCE_AI_TIMEOUT=30
FINANCE_SCHEDULER_ENABLED=false
FINANCE_SCHEDULER_PROCESS_PAYOUTS=false
FINANCE_SCHEDULER_DISPATCH_PROVIDER=
FINANCE_SCHEDULER_DISPATCH_PAYOUTS=false
FINANCE_SCHEDULER_DISPATCH_DRY_RUN=true

# Bank API
BANK_API_ENABLED=false
BANK_API_BASE_URL=
BANK_API_BATCH_PATH=
BANK_API_AUTH_TOKEN=
BANK_API_SOURCE_ACCOUNT_ID=
BANK_API_TIMEOUT_SECONDS=30

# Country AI
COUNTRY_AI_ENABLED=true
COUNTRY_AI_OLLAMA_MODEL=llama3.1
COUNTRY_AI_CACHE_TTL_SECONDS=86400
COUNTRY_AI_WEB_SEARCH_ENABLED=true
COUNTRY_AI_MAX_CONCURRENT_JOBS=5

# WhatsApp
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
WHATSAPP_MIN_DELAY=3.0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=moondream:latest
OLLAMA_TEXT_MODEL=phi3:mini

# Background generation
BG_MAX_CONCURRENT=2
BG_MAX_SESSION_CACHE=2
BG_MAX_IMAGE_DIM=1024
BG_LITE_MAX_DIM=1024
BG_MEMORY_WARN_MB=256
BG_SKIP_HEAVY_MODELS=true

# Defaults
DEFAULT_COUNTRY=AE
LOCATION_CORS_ORIGINS=
DEFAULT_ACCOUNTS_JSON=
LOGIN_LOCKOUT_TTL=900
LOCATION_HTTP_TIMEOUT=4.0
LOCATION_CACHE_TTL=3600
LOCATION_USER_AGENT=zozi-location-service/1.0

# SMS
SMS_MODE=dev
SMS_SERIAL_PORT=COM3
SMS_SERIAL_BAUD=9600
SMS_ANDROID_URL=
SMS_RETRY_ATTEMPTS=3
SMS_RETRY_DELAY=2

# Push notifications
PUSH_MODE=dev
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Retention
OZI_RETENTION_DELETE_ARCHIVED=false
HF_API_TOKEN=
# Application runtime
MAX_PAGE_SIZE=100
REQUEST_TIMEOUT_SECONDS=30
LOG_FILE=
CSRF_DISABLED=
FRONTEND_WS_URL=

# Database TLS
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_ROOT_CERT=

# Field encryption and secrets vault
ENCRYPTION_SALT=
ZOZI_VAULT_MASTER_KEY=

# External providers
TURNSTILE_SECRET_KEY=
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ANALYTICS_API_KEY=
WATCHLIST_API_URL=

# ZOZI MCP client
ZOZI_MCP_API_URL=http://127.0.0.1:8000/api/v1
ZOZI_MCP_USERNAME=
ZOZI_MCP_PASSWORD=

# Background removal
BG_REMOVAL_MODEL=birefnet-general-lite
BG_DEFAULT_STRATEGY=auto
BG_LIGHTWEIGHT_MODE=false
BG_ALLOW_HEAVY_MODELS=true
BG_LIGHT_THREADS=4
BG_HEAVY_THREADS=2
BG_LIGHT_COOLDOWN=60
BG_HEAVY_COOLDOWN=1800
BG_MODEL_LOAD_MIN_MB=700
U2NET_HOME=~/.u2net

# AI model variants
AI_USE_VISION=false
AI_USE_OLLAMA_TEXT=true
MULTIVIEW_SPACE_ID=trellis-community/TRELLIS
ZERO123_MODEL=sudo-ai/zero123plus

# ML worker
ML_WORKER_POLL_INTERVAL=2
ML_WORKER_IDLE_SHUTDOWN=0

# WhatsApp self-hosted gateway
WHATSAPP_MODE=dev
WHATSAPP_SESSION_PATH=./whatsapp_session
WHATSAPP_RATE_LIMIT=20

# Supplier media
MEDIA_STORAGE_PATH=uploads
# Database TLS
DB_SEARCH_PATH=
