APP_ENV=development
SECRET_KEY=change-this-to-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_DATA_ON_STARTUP=true
BOOTSTRAP_SCHEMA_ON_STARTUP=false
RUN_LEGACY_MIGRATIONS_ON_STARTUP=false

DATABASE_URL=sqlite:///zozi.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_CONNECT_TIMEOUT=30

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:19006,http://localhost:19000,http://127.0.0.1:19006,http://127.0.0.1:19000,http://localhost:8081,http://localhost:8090,http://127.0.0.1:8081,http://127.0.0.1:8090

REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@zozi.com

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

OPENAI_API_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

