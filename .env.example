APP_ENV=development
SECRET_KEY=change-this-to-a-strong-random-key
ALGORITHM=HS256
# Short-lived access tokens (5-15 min) with refresh rotation
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_DATA_ON_STARTUP=true
BOOTSTRAP_SCHEMA_ON_STARTUP=false
RUN_LEGACY_MIGRATIONS_ON_STARTUP=false

# PostgreSQL for development (matches docker-compose)
DATABASE_URL=postgresql://zozimarketplace:zozimarketplace@localhost:5432/zozimarketplace
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Redis
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:19006,http://localhost:19000,http://127.0.0.1:19006,http://127.0.0.1:19000,http://localhost:8081,http://localhost:8090,http://127.0.0.1:8081,http://127.0.0.1:8090

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@zozi.com

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

OPENAI_API_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Production settings (uncomment and configure for production)
# APP_ENV=production
# DATABASE_URL=postgresql://user:password@host:5432/zozi
# POSTGRES_DB=zozi
# POSTGRES_USER=zozi_user
# POSTGRES_PASSWORD=your_secure_password
# SENTRY_DSN=
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_CDN_BASE=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Celery settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ML Workers for background processing
ML_WORKERS=2