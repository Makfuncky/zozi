# Dependencies (too large for GitHub)
node_modules/
.pnp/
.pnp.js

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/

# Environment secrets (NEVER push real credentials)
.env
.env.local
.env.production

# Wrangler / Cloudflare worker credentials.
# .env.wrangler held a live CLOUDFLARE_API_TOKEN and was committed in
# bf6d0eb2; it is untracked going forward. The token itself must still be
# revoked/rotated in the Cloudflare dashboard, and history rewritten, since
# ignore rules do not protect already-committed secrets.
.env.wrangler
.wrangler/

# OS files
Thumbs.db
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Build outputs (regeneratable)
.next/
dist/
build/
*.tsbuildinfo

# Expo
.expo/

# Logs (regeneratable)
*.log

# Database files (regeneratable locally)
*.db
*.db-shm
*.db-wal
*.db.bak
*.sqlite
*.sqlite3
.data/
.quarantine/

# Build/audit artifacts that must not be committed (see SYSTEM_AUDIT_REPORT F4)
backend/schema-audit-report.json
backend/alembic_test.json
backend/requirements.lock
backend/schema_mapping.json

# Playwright test artifacts
backend/tests/playwright/test-results/
backend/tests/playwright/auth-*.png
# Browser test artifacts (large local traces/zips must stay out of Git)
_browser_test/test-results/
# Browser-test secrets (local only; copy from stack.env.ps1.example)
config/stack.env.ps1

# Law 27 — backend scratch/debug scripts must never enter the repository
backend/_*.py
backend/test_*.py
backend/debug_*.py
backend/check_*.py
backend/fix_*.py
